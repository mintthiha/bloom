generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CHEQUING
  SAVINGS
  TFSA
  RRSP
  FHSA
  CREDIT
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_OUT
  TRANSFER_IN
}

enum RecurringTransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model Account {
  id              String      @id @default(cuid())
  userId          String
  ownerName       String
  nickname        String?
  accountType     AccountType @default(CHEQUING)
  balance         Decimal     @default(0) @db.Decimal(19, 4)
  frozen          Boolean     @default(false)
  isLinked        Boolean     @default(false)
  plaidAccountId  String?     @unique
  plaidItemId     String?
  institutionName String?
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  sentTransactions     Transaction[] @relation("SentTransactions")
  receivedTransactions Transaction[] @relation("ReceivedTransactions")
  recurringTransactions RecurringTransaction[]
  savingsGoals         SavingsGoal[]
}

model Profile {
  userId                  String   @id
  firstName               String
  lastName                String
  username                String   @unique
  email                   String
  tfsaBirthYear           Int?
  tfsaRoomUsedElsewhere   Decimal? @db.Decimal(19, 4)
  rrspContributionRoom    Decimal? @db.Decimal(19, 4)
  billRemindersEnabled    Boolean  @default(true)
  billReminderLeadDays    Int      @default(3)
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)
}

model CategoryBudget {
  id              String   @id
  userId          String
  category        String
  monthlyLimit    Decimal  @db.Decimal(19, 4)
  rolloverEnabled Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  periods BudgetPeriod[]

  @@unique([userId, category])
}

/// Per-month envelope state for a budget: an optional limit override for that
/// month and a manual adjustment (money moved in/out of the envelope). Carry-in
/// and carry-out are derived from the chain of months, not stored here.
model BudgetPeriod {
  id            String   @id @default(cuid())
  budgetId      String
  userId        String
  month         DateTime @db.Date
  limitOverride Decimal? @db.Decimal(19, 4)
  adjustment    Decimal  @default(0) @db.Decimal(19, 4)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  budget CategoryBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, month])
  @@index([userId])
}

model Transaction {
  id                 String          @id @default(cuid())
  type               TransactionType
  amount             Decimal @db.Decimal(19, 4)
  balanceAfter       Decimal @db.Decimal(19, 4)
  transferGroupId    String?
  category           String?
  merchant           String?
  description        String?
  effectiveAt        DateTime        @default(now()) @db.Timestamptz(3)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  plaidTransactionId String?         @unique

  fromAccountId String?
  fromAccount   Account? @relation("SentTransactions", fields: [fromAccountId], references: [id])

  toAccountId String?
  toAccount   Account? @relation("ReceivedTransactions", fields: [toAccountId], references: [id])

  @@index([fromAccountId, effectiveAt])
  @@index([toAccountId, effectiveAt])
}

// NOTE: accessToken is stored in plain text — encrypt before production.
model PlaidItem {
  id              String   @id @default(cuid())
  userId          String
  accessToken     String
  itemId          String   @unique
  institutionName String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
}

model NetWorthSnapshot {
  id          String   @id @default(cuid())
  userId      String
  month       String
  netWorth    Decimal @db.Decimal(19, 4)
  totalAssets Decimal @db.Decimal(19, 4)
  totalDebt   Decimal @db.Decimal(19, 4)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, month])
}

model SavingsGoal {
  id           String   @id @default(cuid())
  userId       String
  accountId    String
  name         String
  targetAmount Decimal @db.Decimal(19, 4)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model RecurringTransaction {
  id          String                   @id @default(cuid())
  userId      String
  accountId   String
  name        String
  type        RecurringTransactionType
  amount      Decimal @db.Decimal(19, 4)
  category    String?
  merchant    String?
  description String?
  frequency   RecurringFrequency
  startDate   DateTime                 @db.Timestamptz(3)
  endDate     DateTime?                @db.Timestamptz(3)
  nextRunAt   DateTime                 @db.Timestamptz(3)
  lastRunAt   DateTime?                @db.Timestamptz(3)
  active      Boolean                  @default(true)
  createdAt   DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                 @updatedAt @db.Timestamptz(3)

  account     Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([userId, active, nextRunAt])
}

model Notification {
  id                     String    @id @default(cuid())
  userId                 String
  kind                   String
  dedupeKey              String
  recurringTransactionId String?
  title                  String
  body                   String
  dueDate                DateTime? @db.Date
  linkHref               String?
  status                 String    @default("UNREAD")
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  readAt                 DateTime? @db.Timestamptz(3)

  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, status])
}

model AutoCategorizationRule {
  id        String   @id @default(cuid())
  userId    String
  merchant  String
  category  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, merchant])
}

model CredentialUser {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  rememberTokens RememberToken[]
}

// "Remember me" login: an opaque, revocable token exchanged for a session without
// re-entering a password. Only the sha256 hash is stored, so a leaked database row
// can't be replayed as a token, and it never lets a user recover their password.
model RememberToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  user      CredentialUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
