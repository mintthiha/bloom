DATABASE_URL="postgresql://postgres:password@localhost:5432/bloom"
PORT=3001

# Shared secret the Next.js proxy injects and the backend verifies.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=your_secret_here

# Plaid sandbox — get credentials at https://dashboard.plaid.com
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox

# Ollama server for every AI feature (Learn chat + auto-categorization) — the backend is the only
# service that talks to it. Defaults shown; only set these to override. No third-party API key needed.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Keep the model resident between requests (e.g. "-1" to keep loaded indefinitely)
OLLAMA_KEEP_ALIVE=30m
