DATABASE_URL="postgresql://postgres:password@localhost:5432/bloom"
PORT=3001

# Shared secret the Next.js proxy injects and the backend verifies.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=your_secret_here

# Plaid sandbox — get credentials at https://dashboard.plaid.com
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox
